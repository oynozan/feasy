pragma solidity 0.8.24;

import {IStakingGauge} from "./IStakingGauge.sol";

/// @notice Interface for a gauge associated with a vault. The vault generates
///         yield claimable by voters. Vault depositors who staked their vault
///         receipt tokens in the gauge receive gauge rewards.
interface IVaultGauge is IStakingGauge {
    event ClaimFees(address indexed from, uint256 claimed);

    /// @notice Cached amount of fees (yield) generated by the vault linked to this
    ///         gauge and not yet distributed. This may happen when small amount
    ///         of fees was generated in the previous epoch.
    /// @dev We talk about the yield generated as vault as *fees* to reuse the
    ///      trading fee distribution code from pool gauges.
    function fees() external view returns (uint256);
}
