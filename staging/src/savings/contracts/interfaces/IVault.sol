pragma solidity 0.8.33;

/// @title Vault Interface

/// @notice Interface for a yield-generating vault working with a gauge. The
///         vault's receipt token can be staked in a VaultGauge. Stakers receive
///         rewards from the gauge based on the number of votes the gauge
///         receives. In exchange, the gauge receives yield generated by the
///         vault for the receipt tokens staked in the gauge.
/// @dev At minimum, the vault contract must implement ERC20 receipt token.
interface IVault {
    /// @notice The vault's yield token.
    function yieldToken() external view returns (address);

    /// @notice Claims yield from the vault for the receipt tokens held by the
    ///         calling gauge.
    function claimYield() external returns (uint256);
}
